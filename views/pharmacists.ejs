<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>RxPulse - Pharmacists Staff</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="app-container">
        <%- include('partials/nav') %>
        <main class="main-content">
            <header class="welcome-section"><h1>Pharmacist Directory</h1></header>
            <section class="table-container">
                <table class="data-table">
                    <thead>
                        <tr><th>Staff ID</th><th>First Name</th><th>Last Name</th><th>PPB License Number</th></tr>
                    </thead>
                    <tbody>
                        <% pharmacists.forEach(staff => { %>
                            <tr>
                                <td>#<%= staff.pharmacist_id %></td>
                                <td><%= staff.first_name %></td>
                                <td><%= staff.last_name %></td>
                                <td><span style="font-family: monospace; font-weight: 600;"><%= staff.license_number %></span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </section>
        </main>
    </div>
</body>
</html>